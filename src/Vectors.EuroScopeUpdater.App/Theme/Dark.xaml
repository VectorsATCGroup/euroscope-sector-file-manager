<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vectors ATC Group — DARK theme (dark navy surfaces + emerald radar accent). -->
    <SolidColorBrush x:Key="BgBrush" Color="#080B14" />
    <SolidColorBrush x:Key="CardBrush" Color="#0B111D" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#111827" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#1B2636" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F2A3D" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#18B480" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#22C48A" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#062015" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F8FBFC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9DABBE" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F6A823" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62E2E" />
    <SolidColorBrush x:Key="RadarBlipBrush" Color="#10B981" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC05080F" />

    <!-- White-text logo (for dark backgrounds). -->
    <BitmapImage x:Key="LogoSource" UriSource="pack://application:,,,/Assets/vectors-logo-dark.png" />
</ResourceDictionary>
