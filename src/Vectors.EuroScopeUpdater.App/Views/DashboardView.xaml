<UserControl x:Class="Vectors.EuroScopeUpdater.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vectors.EuroScopeUpdater.App.Services"
             xmlns:vm="clr-namespace:Vectors.EuroScopeUpdater.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Margin="28,14,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title block -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="VECTORS ATC GROUP" Style="{StaticResource TechLabel}" />
                <TextBlock Text="EuroScope Sector File Manager" Style="{StaticResource Display}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{loc:Loc Common_Settings}" Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc Dash_Refresh}" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc Dash_UpdateAll}" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Context strip -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                    <TextBlock Text="{loc:Loc Dash_Division}" Style="{StaticResource TechLabel}" />
                    <TextBlock Text="{Binding DivisionName}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,28,0">
                    <TextBlock Text="AIRAC" Style="{StaticResource TechLabel}" />
                    <TextBlock Text="{Binding AiracText}" Style="{StaticResource TechValue}" FontSize="16" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Loc Dash_SectorFiles}" Style="{StaticResource TechLabel}" />
                    <TextBlock Text="{Binding SectorFilesPath}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource RadarBlipBrush}" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Visibility="{Binding EuroScopeDetected, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Body}" FontSize="12"
                                       Text="{loc:Loc Dash_ESDetected}" Visibility="{Binding EuroScopeDetected, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{loc:Loc Dash_ESNotSet}" Visibility="{Binding EuroScopeDetected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Authentication banner — actions stay blocked until authenticated, but the installed status
             below remains visible so you always see what you have. -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12" Padding="18,14"
                Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                Visibility="{Binding NeedsAuth, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Dash_Gate_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{loc:Loc Dash_Gate_Body}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="{loc:Loc Common_Authenticate}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding AuthenticateCommand}" IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Border>

        <!-- FIR list -->
        <ScrollViewer Grid.Row="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Firs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FirItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- FIR code + name -->
                                <StackPanel Grid.Column="0" Width="150">
                                    <TextBlock Text="{Binding Code}" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource ForegroundBrush}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- status chip -->
                                <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- installed -->
                                <StackPanel Grid.Column="2" Margin="18,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Dash_Installed}" Style="{StaticResource TechLabel}" />
                                    <TextBlock Text="{Binding InstalledText}" Style="{StaticResource TechValue}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- available -->
                                <StackPanel Grid.Column="3" Margin="18,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Dash_Available}" Style="{StaticResource TechLabel}" />
                                    <TextBlock Text="{Binding AvailableText}" Style="{StaticResource TechValue}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- action — shown only when Install or Update applies -->
                                <Button Grid.Column="4" VerticalAlignment="Center" MinWidth="120"
                                        Content="{Binding PrimaryActionText}" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding PrimaryActionCommand}"
                                        Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Operation overlay -->
        <Border Grid.RowSpan="4" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding Operation.IsVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="{Binding Operation.Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Operation.PhaseText}" Style="{StaticResource Muted}" Margin="0,6,0,16" />
                    <ProgressBar Style="{StaticResource RadarProgress}"
                                 Value="{Binding Operation.Percent}" Maximum="100"
                                 IsIndeterminate="{Binding Operation.Indeterminate}" />
                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="{Binding Operation.BytesText}" Style="{StaticResource TechLabel}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Content="{loc:Loc Common_Cancel}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Padding="14,7" Command="{Binding CancelOperationCommand}"
                                IsEnabled="{Binding Operation.CanCancel}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
