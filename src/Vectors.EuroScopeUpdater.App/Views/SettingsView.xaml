<UserControl x:Class="Vectors.EuroScopeUpdater.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vectors.EuroScopeUpdater.App.Services"
             xmlns:vm="clr-namespace:Vectors.EuroScopeUpdater.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Grid Margin="40,20,40,28" MaxWidth="760" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="VECTORS ATC GROUP" Style="{StaticResource TechLabel}" />
            <TextBlock Text="{loc:Loc Common_Settings}" Style="{StaticResource Display}" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_Locations}" Style="{StaticResource TechLabel}" />
                    <TextBlock Text="{loc:Loc Set_ESFolder}" Style="{StaticResource Body}" Margin="0,10,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Field}" Width="520" Text="{Binding EuroScopePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Set_Change}" Style="{StaticResource GhostButton}" Command="{Binding ChangeEuroScopeCommand}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Set_SFLocation}" Style="{StaticResource Body}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource Field}" Width="520" Text="{Binding SectorFilesPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Set_Change}" Style="{StaticResource GhostButton}" Command="{Binding ChangeLocationCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Set_BackupsKeep}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource Field}" Width="60" Text="{Binding BackupsToKeep, Mode=TwoWay}" />
                        <Button Content="{loc:Loc Set_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Language selector -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_Language}" Style="{StaticResource TechLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Português" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding SetLanguageCommand}" CommandParameter="Pt" />
                        <Button Content="English" Style="{StaticResource GhostButton}"
                                Command="{Binding SetLanguageCommand}" CommandParameter="En" />
                        <TextBlock Text="{Binding CurrentLanguageLabel}" Style="{StaticResource TechValue}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_AuthData}" Style="{StaticResource TechLabel}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,10" TextWrapping="Wrap"
                               Text="{loc:Loc Set_LogoutDesc}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Set_Logout}" Style="{StaticResource GhostButton}" Command="{Binding LogoutCommand}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Set_OpenAppData}" Style="{StaticResource GhostButton}" Command="{Binding OpenAppDataCommand}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Set_OpenLogs}" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Set_OpenBackups}" Style="{StaticResource GhostButton}" Command="{Binding OpenBackupsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_Updates}" Style="{StaticResource TechLabel}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,10" TextWrapping="Wrap"
                               Text="{loc:Loc Set_Updates_Desc}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Set_Updates_Auto}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:Loc Common_On}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding SetAutoUpdateCommand}" CommandParameter="On" />
                        <Button Content="{loc:Loc Common_Off}" Style="{StaticResource GhostButton}"
                                Command="{Binding SetAutoUpdateCommand}" CommandParameter="Off" />
                        <TextBlock Text="{Binding AutoUpdateStateLabel}" Style="{StaticResource TechValue}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Set_Updates_CheckNow}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CheckUpdatesNowCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UpdateStatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- How this software works -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_How_Title}" Style="{StaticResource TechLabel}" />
                    <TextBlock Text="{loc:Loc Set_How_Login_H}" Style="{StaticResource H2}" FontSize="14" Margin="0,10,0,0" />
                    <TextBlock Text="{loc:Loc Set_How_Login}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{loc:Loc Set_How_Storage_H}" Style="{StaticResource H2}" FontSize="14" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc Set_How_Storage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{loc:Loc Set_How_Updates_H}" Style="{StaticResource H2}" FontSize="14" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc Set_How_Updates}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <TextBlock Text="{loc:Loc Set_How_NoCollect}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Set_About}" Style="{StaticResource TechLabel}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                               Text="Vectors ATC Group - EuroScope Sector File Manager" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="{loc:Loc Set_About_Independent}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://vectorsatcgroup.com/" RequestNavigate="OnNavigate"
                                   Foreground="{DynamicResource PrimaryBrush}" TextDecorations="Underline">
                            <Run Text="{loc:Loc Set_About_Link}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Style="{StaticResource TechLabel}" Margin="0,10,0,0" Text="{Binding VersionLabel}" />
                </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="{loc:Loc Set_Back}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                Command="{Binding BackCommand}" Margin="0,18,0,0" />
    </Grid>
</UserControl>
