<Window x:Class="Vectors.EuroScopeUpdater.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vectors.EuroScopeUpdater.App.Services"
        xmlns:vm="clr-namespace:Vectors.EuroScopeUpdater.App.ViewModels"
        xmlns:v="clr-namespace:Vectors.EuroScopeUpdater.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vectors ATC Group - EuroScope Sector File Manager"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1040" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
            <v:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar / brand (distinct surface + bottom divider so the header reads as a header) -->
        <Border Grid.Row="0" Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Image Source="{DynamicResource LogoSource}" Height="28" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="16,0" />
                    <TextBlock Text="EUROSCOPE SECTOR FILE MANAGER" Style="{StaticResource TechLabel}" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button ToolTip="{loc:Loc Common_ThemeTooltip}" Content="{Binding ThemeGlyph}" Command="{Binding ToggleThemeCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource GhostButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="11" Width="40" Height="32" Padding="0" BorderBrush="Transparent" />
                    <Button x:Name="MinButton" Content="&#xE921;" Click="OnMinimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource GhostButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="11" Width="40" Height="32" Padding="0" BorderBrush="Transparent" />
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Click="OnClose"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource GhostButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="11" Width="40" Height="32" Padding="0" BorderBrush="Transparent" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0" />
    </Grid>
</Window>
